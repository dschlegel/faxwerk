/* Faxwerk desktop theme. @name stands for a color role; Theme.cpp replaces
   it with the light or the dark value (see ThemeColors in Theme.h). */

QMainWindow, QWidget#page, QScrollArea, QScrollArea > QWidget > QWidget#scrollContent {
    background: @window;
}

QWidget {
    color: @text;
}

/* Top bar */
QFrame#topBar {
    background: @window;
    border: none;
    border-bottom: 1px solid @border;
}
QLabel#productName {
    font-size: 18px;
    font-weight: 600;
}
QPushButton[role="nav"] {
    background: transparent;
    border: 2px solid transparent;
    border-radius: 18px;
    padding: 6px 14px;
    color: @accentText;
    font-weight: 500;
    min-height: 20px;
}
QPushButton[role="nav"]:hover {
    background: @lilacSoft;
}
QPushButton[role="nav"]:checked {
    background: @lilac;
}
QPushButton[role="nav"]:disabled {
    color: @navDisabled;
}

/* Status chip: shows the reachable location, click to look again */
QPushButton#statusChip {
    border: none;
    border-radius: 16px;
    padding: 0 14px;
    min-height: 32px;
    max-height: 32px;
    font-size: 14px;
    font-weight: 400;
    background: @lilac;
    color: @accentText;
}
QPushButton#statusChip:hover {
    background: @lilacHover;
}

/* Update chip: a new version of the AppImage is available */
QPushButton#updateChip {
    border: none;
    border-radius: 16px;
    padding: 0 14px;
    min-height: 32px;
    max-height: 32px;
    font-size: 14px;
    font-weight: 500;
    background: @primary;
    color: @onPrimary;
}
QPushButton#updateChip:hover {
    background: @primaryHover;
}
QPushButton#updateChip:disabled {
    background: @lilac;
    color: @muted;
}

/* Bar below the "Neues Fax" page in narrow windows, holds the send button */
QFrame#sendFooter {
    background: @surface;
    border: none;
    border-top: 1px solid @border;
}

/* Text */
QLabel[role="title"] {
    font-size: 36px;
    font-weight: 600;
}
QLabel[role="subtitle"], QLabel[role="muted"] {
    color: @muted;
}
QLabel[role="subtitle"] {
    font-size: 16px;
}
QLabel[role="muted"] {
    font-size: 13px;
}
QLabel[role="fieldLabel"] {
    color: @accentText;
    font-size: 14px;
    font-weight: 500;
}
QLabel[role="sectionTitle"] {
    font-size: 20px;
    font-weight: 600;
}

/* Cards */
QFrame[role="card"] {
    background: @surface;
    border: 1px solid @border;
    border-radius: 26px;
}
QFrame[role="darkCard"] {
    background: @deep;
    border: none;
    border-radius: 30px;
}
QFrame[role="darkCard"] QLabel {
    color: @onDark;
    background: transparent;
}
QFrame[role="darkCard"] QLabel[role="onDarkMuted"] {
    color: @onDarkMuted;
}
QFrame[role="divider"] {
    background: @divider;
    border: none;
    max-height: 1px;
    min-height: 1px;
}

/* Inputs */
QLineEdit, QComboBox {
    background: @surface;
    border: 1px solid @border;
    border-radius: 14px;
    padding: 0 14px;
    min-height: 46px;
    font-size: 16px;
    selection-background-color: @primary;
}
QLineEdit:focus, QComboBox:focus {
    border: 2px solid @primary;
    padding: 0 13px;
}
QLineEdit#destination {
    font-size: 24px;
    font-weight: 500;
    min-height: 56px;
    border-radius: 16px;
}
QComboBox::drop-down {
    border: none;
    width: 28px;
}
QComboBox QAbstractItemView {
    border: 1px solid @border;
    selection-background-color: @lilac;
    selection-color: @text;
}
QListView#contactPopup {
    background: @surface;
    border: 1px solid @border;
    border-radius: 12px;
    padding: 4px 0;
    outline: none;
}
QCheckBox {
    spacing: 10px;
    font-size: 14px;
}

/* Buttons: pill shaped like the website */
QPushButton {
    border-radius: 24px;
    padding: 0 24px;
    min-height: 48px;
    font-size: 15px;
    font-weight: 600;
    background: @surface;
    color: @accentText;
    border: 1.5px solid @border;
}
QPushButton:hover {
    background: @lilacSoft;
}
QPushButton:pressed {
    background: @lilac;
}
/* Buttons only take the focus from the keyboard (see Theme.cpp), so this is
   the keyboard focus ring. */
QPushButton:focus {
    border-color: @focusBorder;
}
QPushButton:disabled {
    color: @disabledText;
    background: @disabledBg;
}
QPushButton[role="primary"] {
    background: @primary;
    color: @onPrimary;
    /* Transparent until focused, so the focus ring does not change the size */
    border: 2px solid transparent;
}
QPushButton[role="primary"]:hover {
    background: @primaryHover;
}
QPushButton[role="primary"]:pressed {
    background: @primaryPressed;
}
QPushButton[role="primary"]:focus {
    border-color: @focus;
}
QPushButton[role="primary"]:disabled {
    background: @primaryDisabled;
    color: @onPrimary;
}
QPushButton[role="primary"][size="big"] {
    min-height: 56px;
    border-radius: 28px;
    font-size: 17px;
}
QPushButton[role="link"] {
    background: transparent;
    border: none;
    padding: 0;
    min-height: 28px;
    color: @link;
    font-weight: 500;
    text-align: left;
}
QPushButton[role="link"]:hover, QPushButton[role="link"]:focus {
    color: @accentText;
    text-decoration: underline;
}
QPushButton[role="link"]:focus {
    border: none;
}
QPushButton#addPdf {
    min-width: 150px;
    max-width: 150px;
    min-height: 212px;
    max-height: 212px;
    padding: 0;
    border: 1.5px dashed @dashed;
    border-radius: 6px;
    background: @window;
    color: @link;
    font-weight: 500;
    font-size: 14px;
}
QPushButton#addPdf:hover {
    background: @lilacSoft;
}
QPushButton[role="recent"] {
    text-align: left;
    border: 2px solid transparent;
    border-radius: 14px;
    padding: 8px 14px;
    background: transparent;
    font-weight: 500;
    color: @text;
}
QPushButton[role="recent"]:hover {
    background: @lilacSoft;
}
QPushButton[role="recent"]:focus {
    border-color: @focusBorder;
}
QToolButton#disclosure {
    border: none;
    background: transparent;
    color: @accentText;
    font-weight: 500;
    font-size: 14px;
    padding: 4px 0;
}

/* Lists */
QListWidget {
    background: @surface;
    border: 1px solid @border;
    border-radius: 22px;
    padding: 6px;
    outline: none;
}
QListWidget::item {
    border-radius: 14px;
    margin: 1px 0;
}
QListWidget::item:selected, QListWidget::item:selected:active {
    background: @lilacSoft;
    color: @text;
}
QListWidget::item:hover {
    background: @window;
}

/* Status pills */
QLabel[pill="ok"] {
    background: @okBg;
    color: @okText;
    border-radius: 11px;
    padding: 3px 11px;
    font-size: 13px;
    font-weight: 500;
}
QLabel[pill="warn"] {
    background: @warnBg;
    color: @warnText;
    border-radius: 11px;
    padding: 3px 11px;
    font-size: 13px;
    font-weight: 500;
}
QLabel[pill="fail"] {
    background: @failBg;
    color: @failText;
    border-radius: 11px;
    padding: 3px 11px;
    font-size: 13px;
    font-weight: 500;
}

/* Banners */
QLabel[banner="ok"] {
    background: @okBg;
    color: @okText;
    border-radius: 16px;
}
QLabel[banner="fail"] {
    background: @failBg;
    color: @failText;
    border-radius: 16px;
}
QLabel[banner="info"] {
    background: @lilac;
    color: @accentText;
    border-radius: 16px;
}

QScrollBar:vertical {
    background: transparent;
    width: 10px;
    margin: 4px 2px;
}
QScrollBar::handle:vertical {
    background: @scroll;
    border-radius: 3px;
    min-height: 40px;
}
QScrollBar:horizontal {
    background: transparent;
    height: 10px;
    margin: 2px 4px;
}
QScrollBar::handle:horizontal {
    background: @scroll;
    border-radius: 3px;
    min-width: 40px;
}
QScrollBar::add-line, QScrollBar::sub-line, QScrollBar::add-page, QScrollBar::sub-page {
    background: none;
    border: none;
    width: 0;
    height: 0;
}
